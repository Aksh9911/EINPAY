  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate random transaction ID if not set",
          "if (!pm.environment.get('clientTransactionId')) {",
          "    pm.environment.set('clientTransactionId', 'TXN' + Date.now());",
          "}",
          "",
          "// Set default IP if not set",
          "if (!pm.environment.get('clientIP')) {",
          "    pm.environment.set('clientIP', '127.0.0.1');",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://einpay.rollix777.com",
      "type": "string"
    },
    {
      "key": "clientTransactionId",
      "value": "TXN123456",
      "type": "string"
    },
    {
      "key": "clientIP",
      "value": "127.0.0.1",
      "type": "string"
    },
    {
      "key": "transactionId",
      "value": "EINPAY12345",
      "type": "string"
    }
  ]
