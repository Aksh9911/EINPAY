              "mode": "raw",
              "raw": "{\n  \"amount\": 1000,\n  \"requested_method\": \"UPI\",\n  \"client_user_id\": \"USER123\",\n  \"client_transaction_id\": \"TXN{{$randomInt}}\",\n  \"client_user_ipaddr\": \"{{clientIP}}\",\n  \"device_type\": 20\n}"
