# ============================================
# EINPAY Gateway Configuration
# ============================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Base URLs
BASE_URL=https://einpay.rollix777.com
EINPAY_BASE_URL=https://pay18.einpays.com

# EINPAY Merchant Configuration
EINPAY_CLIENT_ID=415
EINPAY_COUNTRY_ID=1
EINPAY_CURRENCY_ID=3
TRAFFIC_LEVEL=2

# Key Paths (Relative to project root)
PRIVATE_KEY_PATH=./keys/private.pem
PUBLIC_KEY_PATH=./keys/public.pem
EINPAY_API_PUBLIC_KEY_PATH=./keys/einpay-api-public.pem
EINPAY_CALLBACK_PUBLIC_KEY_PATH=./keys/einpay-callback-public.pem

# Callback URL (Payin)
CALLBACK_URL=https://einpay.rollix777.com/api/einpay/callback

# Payout Callback URL
PAYOUT_CALLBACK_URL=https://einpay.rollix777.com/api/einpay/payout/callback

# Request Configuration
REQUEST_TIMEOUT=30000
MAX_RETRIES=3
RETRY_DELAY=1000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_MAX_FILES=30
LOG_MAX_SIZE=10m

# CORS
ALLOWED_ORIGINS=https://www.rollix777.com,https://rollix777.com

# Security
BCRYPT_ROUNDS=12
JWT_EXPIRY=300

# Deposit Limits
UPI_MIN_AMOUNT=300
UPI_MAX_AMOUNT=100000
BANK_MIN_AMOUNT=500
BANK_MAX_AMOUNT=100000

# MySQL Database Configuration
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_database
DB_PORT=3306
DB_TABLE_NAME=recharge
